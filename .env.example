# LinkedIn API credentials for the linkedin-publisher agent.
# Copy this file to `.env` (gitignored) and fill in real values.
#
# How to obtain these (one-time, ~15-30 minutes):
#
#   1. Create a LinkedIn developer app:
#      https://www.linkedin.com/developers/apps -> "Create app"
#      (You must associate it with a company page you administer.)
#
#   2. In the "Products" tab, add:
#        - "Share on LinkedIn"
#        - "Sign In with LinkedIn using OpenID Connect"
#      Approval is usually instant.
#
#   3. In the "Auth" tab, add a redirect URL such as
#      http://localhost:8000/callback, then note Client ID + Client Secret.
#
#   4. Generate an OAuth 2.0 access token with scopes:
#        openid  profile  w_member_social
#      The "OAuth 2.0 Tools" tab in the developer portal can do this
#      interactively. Tokens are valid for ~60 days.
#
#   5. Fetch your member URN:
#        curl -H "Authorization: Bearer $TOKEN" \
#             https://api.linkedin.com/v2/userinfo
#      The `sub` field is your member ID; the URN is `urn:li:person:<sub>`.
#
#   6. When the token expires (401 errors), redo step 4.

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID
